---
import Layout from '../layouts/Layout.astro';
---

<Layout titleKey="nav.daily" title="Daily timer" description="Split your daily meeting time across the team and show a big countdown everyone can see. Free, no login.">
  <!-- ───────────── Setup ───────────── -->
  <section id="setup" class="wrap page">
    <header class="page-head">
      <h1 data-i18n="setup.title">Daily timer</h1>
      <p class="lead" data-i18n="setup.lead">Set up the team once. It is saved in this browser for the next daily.</p>
    </header>

    <div id="resume-banner" class="card banner" hidden>
      <span data-i18n="setup.resume">A daily is still running in this browser.</span>
      <span class="banner-actions">
        <button type="button" class="btn small" id="resume-btn" data-i18n="common.resume">Resume</button>
        <button type="button" class="btn small ghost" id="discard-btn" data-i18n="common.discard">Discard</button>
      </span>
    </div>

    <div class="team-bar">
      <label class="section-label" for="team-select" data-i18n="setup.team">Team</label>
      <div class="team-row">
        <select id="team-select"></select>
        <button type="button" class="btn small ghost" id="team-new" data-i18n="setup.newTeam">New team</button>
        <button type="button" class="btn small ghost" id="team-rename" data-i18n="setup.renameTeam">Rename</button>
        <button type="button" class="btn small ghost" id="team-delete" data-i18n="setup.deleteTeam">Delete</button>
      </div>
    </div>

    <div class="grid">
      <div class="card">
        <div class="card-head">
          <h2 class="section-label" data-i18n="setup.people">People</h2>
          <span class="muted small" id="present-count"></span>
        </div>
        <form id="add-form" class="add-row">
          <input type="text" id="add-input" autocomplete="off" data-i18n-placeholder="setup.addPlaceholder" />
          <button type="submit" class="btn" data-i18n="common.add">Add</button>
        </form>
        <ul id="people" class="row-list"></ul>
        <p id="people-empty" class="muted empty" data-i18n="setup.empty" hidden>No one here yet.</p>
      </div>

      <div class="card settings">
        <fieldset>
          <legend class="section-label" data-i18n="setup.order">Speaking order</legend>
          <div class="opt-grid">
            <label class="opt">
              <input type="radio" name="order" value="shuffle" />
              <svg class="opt-icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 3h5v5M4 20 21 3M21 16v5h-5M15 15l6 6M4 4l5 5"/></svg>
              <b data-i18n="setup.order.shuffle">Shuffle</b>
              <small data-i18n="setup.order.shuffle.hint">Random every time</small>
            </label>
            <label class="opt">
              <input type="radio" name="order" value="saved" />
              <svg class="opt-icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 6h11M10 12h11M10 18h11M4 6h1v4M4 10h2M6 18H4c0-1 2-2 2-3s-1-1.5-2-1"/></svg>
              <b data-i18n="setup.order.saved">Saved order</b>
              <small data-i18n="setup.order.saved.hint">The order of the list</small>
            </label>
            <label class="opt">
              <input type="radio" name="order" value="alpha" />
              <svg class="opt-icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 16l4 4 4-4M7 20V4M15 4h5l-5 7h5M15 20l2.5-6 2.5 6M15.8 18h3.4"/></svg>
              <b data-i18n="setup.order.alpha">Alphabetical</b>
              <small data-i18n="setup.order.alpha.hint">A to Z</small>
            </label>
          </div>
        </fieldset>

        <fieldset>
          <legend class="section-label" data-i18n="setup.time">Time</legend>
          <div class="time-fields">
            <label class="field"><span data-i18n="setup.duration">Meeting length (min)</span><input type="number" id="duration" min="1" max="240" step="1" inputmode="numeric" /></label>
            <label class="field"><span data-i18n="setup.buffer">Reserved for general topics (min)</span><input type="number" id="buffer" min="0" max="120" step="1" inputmode="numeric" /></label>
          </div>
          <div class="chips presets" id="presets">
            <button type="button" class="chip" data-min="15">15 min</button>
            <button type="button" class="chip" data-min="20">20 min</button>
            <button type="button" class="chip" data-min="30">30 min</button>
            <button type="button" class="chip" data-min="45">45 min</button>
          </div>
          <label class="toggle"><input type="checkbox" id="adaptive" /><span><b data-i18n="setup.adaptive">Adaptive time</b><small data-i18n="setup.adaptive.hint"></small></span></label>
          <label class="toggle"><input type="checkbox" id="sound" /><span><b data-i18n="setup.sound">Sound alerts</b><small data-i18n="setup.sound.hint"></small></span></label>
        </fieldset>

        <div class="start">
          <p class="estimate" id="estimate"></p>
          <button type="button" class="btn big" id="start-btn" data-i18n="setup.start">Start daily</button>
          <p class="muted small" id="start-hint" data-i18n="setup.needPeople" hidden></p>
        </div>
      </div>
    </div>
  </section>

  <!-- ───────────── Running ───────────── -->
  <section id="run" class="run timer" hidden>
    <div class="run-top">
      <span class="run-meta" id="run-position"></span>
      <span class="run-meta meeting">
        <span id="meeting-label"></span>
        <b id="meeting-clock" class="mono"></b>
      </span>
      <span class="run-top-actions">
        <button type="button" class="icon-btn" id="fs-btn" data-i18n-title="common.fullscreen">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5"/></svg>
        </button>
        <button type="button" class="btn small ghost" id="end-btn" data-i18n="run.end">End daily</button>
      </span>
    </div>

    <div class="stage">
      <p class="now-label" id="now-label"></p>
      <h2 class="now-name" id="now-name"></h2>
      <div class="clock" id="clock" role="timer" aria-live="off"></div>
      <p class="clock-sub" id="clock-sub"></p>
      <div class="bar" aria-hidden="true"><div class="bar-fill" id="bar-fill"></div></div>
      <p class="up-next" id="up-next"></p>
    </div>

    <div class="controls">
      <button type="button" class="btn ghost" id="prev-btn"><span data-i18n="run.prev">Back</span> <kbd>←</kbd></button>
      <button type="button" class="btn ghost" id="pause-btn"><span id="pause-label"></span> <kbd>P</kbd></button>
      <button type="button" class="btn big" id="next-btn"><span id="next-label"></span> <kbd>Space</kbd></button>
      <button type="button" class="btn ghost" id="skip-btn"><span data-i18n="run.skip">Skip</span> <kbd>S</kbd></button>
      <button type="button" class="btn ghost" id="plus-btn" data-i18n="run.plus">+1 min</button>
    </div>

    <div class="wrap queue-wrap">
      <h3 class="section-label" data-i18n="run.queue">Order</h3>
      <ol class="queue" id="queue"></ol>
      <form class="late" id="late-form">
        <label for="late-input" class="muted small" data-i18n="run.addLate">Someone arrived late?</label>
        <span class="late-row">
          <input type="text" id="late-input" autocomplete="off" data-i18n-placeholder="run.addLatePlaceholder" />
          <button type="submit" class="btn small ghost" data-i18n="common.add">Add</button>
        </span>
      </form>
      <p class="muted small shortcuts" data-i18n="run.shortcuts"></p>
    </div>
  </section>

  <!-- ───────────── Summary ───────────── -->
  <section id="summary" class="wrap summary-page" hidden>
    <h1 data-i18n="sum.title">Daily done</h1>
    <div class="sum-stats">
      <div class="card stat">
        <span class="muted small" data-i18n="common.totalTime">Total time</span>
        <b class="mono" id="sum-total"></b>
        <span class="muted small" id="sum-planned"></span>
      </div>
      <div class="card stat verdict-card" id="sum-verdict-card">
        <b class="verdict" id="sum-verdict"></b>
      </div>
    </div>
    <div class="card table-card">
      <table class="sum-table">
        <thead>
          <tr><th data-i18n="sum.person">Person</th><th data-i18n="sum.used">Spoke</th><th data-i18n="sum.slot">Slot</th><th class="bar-col"></th></tr>
        </thead>
        <tbody id="sum-rows"></tbody>
      </table>
    </div>
    <button type="button" class="btn big" id="again-btn" data-i18n="sum.again">New daily</button>
  </section>

  <script>
    import { initDaily } from '../features/daily/daily';
    initDaily();
  </script>
</Layout>

<style>
  /* Shared pieces (lists, option cards, timer states, summary) come from @sapphirelabs/ui. */

  /* ── Setup ── */
  .team-bar { margin-bottom: 20px; }
  .team-row { display: flex; gap: 8px; flex-wrap: wrap; }
  .team-row select { flex: 1 1 200px; max-width: 320px; }
  .grid { display: grid; gap: 20px; grid-template-columns: minmax(0, 1fr); }
  .grid > * { min-width: 0; }
  @media (min-width: 900px) { .grid { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); align-items: start; } }
  .card-head { display: flex; justify-content: space-between; align-items: baseline; }
  .card-head .section-label { margin-bottom: 14px; }
  .add-row { margin-bottom: 14px; }
  .empty { margin: 8px 0 0; }
  .time-fields { display: grid; gap: 12px; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); }
  .time-fields .field { justify-content: space-between; }
  .time-fields input { font-size: 1.1rem; }
  .presets { margin: 12px 0 18px; }
  .toggle { margin-top: 12px; }
  .start { border-top: 1px solid var(--border); padding-top: 18px; display: flex; flex-direction: column; gap: 10px; }
  .estimate { margin: 0; color: var(--muted); }
  .estimate :global(b) { color: var(--text); font-family: var(--font-mono); }

  /* ── Running ── */
  .run {
    min-height: 100vh; display: flex; flex-direction: column; position: relative;
    background: radial-gradient(900px 520px at 50% 30%, color-mix(in srgb, var(--state) var(--state-glow, 12%), transparent), transparent 70%);
    transition: background 0.6s;
  }
  .run-top {
    display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap;
    padding: 18px 24px; border-bottom: 1px solid var(--border);
  }
  .run-meta { color: var(--muted); font-size: 0.95rem; }
  .meeting { display: inline-flex; gap: 10px; align-items: baseline; }
  .meeting b { color: var(--text); font-size: 1.2rem; }
  .meeting.over b { color: var(--danger); }
  .run-top-actions { display: flex; gap: 8px; align-items: center; }

  .stage { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 24px 16px 8px; }
  .now-label { margin: 0; font-family: var(--font-mono); font-size: 0.85rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--state); }
  .now-name {
    margin: 6px 0 0; font-size: clamp(2.4rem, 7vw, 6rem); line-height: 1.05; letter-spacing: -0.03em; font-weight: 700;
    max-width: 100%; overflow-wrap: anywhere;
  }
  .clock { font-size: clamp(5rem, 19vw, 15rem); letter-spacing: -0.04em; margin-top: 12px; }
  .clock-sub { margin: 4px 0 0; color: var(--muted); font-size: 1rem; min-height: 1.6em; }
  .stage .bar { width: min(720px, 100%); margin-top: 18px; }
  .up-next { margin: 22px 0 0; color: var(--muted); font-size: 1.15rem; min-height: 1.6em; }
  .up-next :global(b) { color: var(--text); }

  .controls { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; padding: 16px; }

  .queue-wrap { padding-top: 18px; padding-bottom: 32px; }
  .queue { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .queue :global(li button) {
    font: inherit; display: inline-flex; align-items: center; gap: 8px; padding: 6px 12px; border-radius: 999px; cursor: pointer;
    background: var(--surface); border: 1px solid var(--border); color: var(--text); font-size: 0.9rem;
  }
  .queue :global(li button:hover) { border-color: var(--border-strong); }
  .queue :global(li .t) { font-family: var(--font-mono); font-size: 0.78rem; color: var(--muted); }
  .queue :global(li.active button) { border-color: var(--state); background: color-mix(in srgb, var(--state) 14%, var(--surface)); cursor: default; }
  .queue :global(li.done button) { color: var(--muted); }
  .queue :global(li.done .t.over) { color: var(--danger); }
  .queue :global(li.done .t.ok) { color: var(--ok); }
  .queue :global(li.skipped button) { color: var(--muted); text-decoration: line-through; opacity: 0.6; }
  .late { margin-top: 18px; display: flex; flex-direction: column; gap: 6px; max-width: 360px; }
  .late-row { display: flex; gap: 8px; }
  .late-row input { flex: 1; }
  .shortcuts { margin-top: 18px; }
</style>
