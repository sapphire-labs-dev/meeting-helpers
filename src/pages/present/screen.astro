---
import I18nBoot from '@sapphirelabs/ui/components/I18nBoot.astro';
import faviconUrl from '@sapphirelabs/ui/assets/favicon.ico?url';
import { dict } from '../../i18n';
// Audience window: only the slide, nothing private. This is the window the
// presenter shares in the call. Deliberately without the site header/footer.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Slides</title>
    <link rel="icon" href={faviconUrl} sizes="any" />
  </head>
  <body>
    <canvas id="slide"></canvas>
    <p id="status" class="status" data-i18n="aud.waiting">Waiting for the presenter…</p>
    <p id="hint" class="hint" data-i18n="aud.hint">Press F or double-click for full screen</p>
    <I18nBoot {dict} />
    <script>
      import { initScreen } from '../../features/present/screen';
      initScreen();
    </script>
  </body>
</html>

<style is:global>
  html, body { margin: 0; height: 100%; background: #000; color: #eceef3; overflow: hidden; }
  body { display: grid; place-items: center; font-family: 'Inter', system-ui, sans-serif; cursor: default; }
  body.idle { cursor: none; }
  [hidden] { display: none !important; }
  canvas { display: block; }
  .status { position: absolute; margin: 0; font-size: 1.4rem; color: #979dad; }
  .status.big { font-size: clamp(2rem, 6vw, 4rem); color: #eceef3; font-weight: 600; }
  .hint {
    position: fixed; bottom: 16px; left: 50%; transform: translateX(-50%); margin: 0;
    font-size: 0.85rem; color: #979dad; background: rgba(18, 21, 28, 0.85); padding: 6px 14px; border-radius: 999px;
    transition: opacity 0.6s; pointer-events: none;
  }
  .hint.gone { opacity: 0; }
</style>
